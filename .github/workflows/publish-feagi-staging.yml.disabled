name: Publish FEAGI SDK to Test PyPI (Staging)

# Trigger on push/merge to staging branch
on:
  push:
    branches:
      - staging
    paths:
      - 'feagi/**'
      - 'pyproject.toml'
      - 'setup.py'
      - '.github/workflows/publish-feagi-staging.yml'

permissions:
  contents: read

jobs:
  publish:
    name: Build and Publish to Test PyPI
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      
      - name: Install build dependencies
        run: |
          python -m pip install --upgrade pip
          pip install build twine
      
      - name: Extract version from pyproject.toml
        id: get_version
        run: |
          VERSION=$(grep -m 1 'version = ' pyproject.toml | cut -d'"' -f2)
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "📦 Building FEAGI SDK version: $VERSION"
      
      - name: Build package
        run: |
          echo "🔨 Building FEAGI SDK package..."
          python -m build
          echo "✅ Build complete!"
          ls -lh dist/
      
      - name: Check distribution
        run: |
          echo "🔍 Checking package integrity..."
          python -m twine check dist/*
      
      - name: Publish to Test PyPI
        env:
          TWINE_USERNAME: __token__
          TWINE_PASSWORD: ${{ secrets.TEST_PYPI_API_TOKEN }}
        run: |
          echo "📤 Publishing to test.pypi.org..."
          python -m twine upload --repository testpypi dist/*
          echo "✅ Published successfully!"
          echo ""
          echo "📦 Package: feagi"
          echo "🔢 Version: ${{ steps.get_version.outputs.version }}"
          echo "🔗 URL: https://test.pypi.org/project/feagi/${{ steps.get_version.outputs.version }}/"
          echo ""
          echo "To install:"
          echo "  pip install --index-url https://test.pypi.org/simple/ --extra-index-url https://pypi.org/simple/ feagi==${{ steps.get_version.outputs.version }}"
      
      - name: Summary
        run: |
          echo "## 🚀 FEAGI SDK Published to Test PyPI" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Package:** feagi" >> $GITHUB_STEP_SUMMARY
          echo "**Version:** ${{ steps.get_version.outputs.version }}" >> $GITHUB_STEP_SUMMARY
          echo "**Repository:** test.pypi.org" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### Installation" >> $GITHUB_STEP_SUMMARY
          echo '```bash' >> $GITHUB_STEP_SUMMARY
          echo "pip install --index-url https://test.pypi.org/simple/ --extra-index-url https://pypi.org/simple/ feagi==${{ steps.get_version.outputs.version }}" >> $GITHUB_STEP_SUMMARY
          echo '```' >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### View Package" >> $GITHUB_STEP_SUMMARY
          echo "🔗 [https://test.pypi.org/project/feagi/${{ steps.get_version.outputs.version }}/](https://test.pypi.org/project/feagi/${{ steps.get_version.outputs.version }}/)" >> $GITHUB_STEP_SUMMARY

