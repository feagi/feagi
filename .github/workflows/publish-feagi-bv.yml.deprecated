name: Publish FEAGI BV Runtime

on:
  push:
    branches:
      - staging
      - main
  workflow_dispatch:
    inputs:
      bv_version:
        description: "Brain Visualizer release tag (e.g., v1.2.3) or 'latest'"
        required: false
        default: "latest"
      major_version:
        description: "Major version gate (e.g., 1 or 2) - only process BV releases with this major version"
        required: false
        default: "1"

env:
  BV_MAJOR_VERSION: "1"  # Change this when moving to BV 2.x

permissions:
  contents: read
  id-token: write  # Required for trusted publishing to PyPI

jobs:
  build-linux:
    name: Build feagi-bv wheel (Linux)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Resolve Brain Visualizer release
        id: bv
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Use input version if provided, otherwise use latest
          BV_INPUT="${{ inputs.bv_version }}"
          if [ -z "$BV_INPUT" ] || [ "$BV_INPUT" = "latest" ]; then
            BV_TAG=$(gh release view --repo feagi/brain-visualizer --json tagName -q .tagName)
          else
            BV_TAG="$BV_INPUT"
          fi
          echo "tag=${BV_TAG}" >> $GITHUB_OUTPUT
          
          # Extract version number (remove 'v' prefix if present)
          BV_VERSION="${BV_TAG#v}"
          echo "version=${BV_VERSION}" >> $GITHUB_OUTPUT
          
          # Extract major version
          BV_MAJOR=$(echo "$BV_VERSION" | cut -d. -f1)
          echo "major=${BV_MAJOR}" >> $GITHUB_OUTPUT
          
          # Get the gating major version
          GATE_MAJOR="${{ inputs.major_version }}"
          if [ -z "$GATE_MAJOR" ]; then
            GATE_MAJOR="${{ env.BV_MAJOR_VERSION }}"
          fi
          
          echo "🔍 Brain Visualizer release: ${BV_TAG} (version: ${BV_VERSION})"
          echo "🔒 Major version gate: ${GATE_MAJOR}"
          
          # Validate major version matches gate
          if [ "$BV_MAJOR" != "$GATE_MAJOR" ]; then
            echo "❌ ERROR: BrainVisualizer major version ${BV_MAJOR} does not match gate ${GATE_MAJOR}"
            echo "To process BV ${BV_VERSION}, update BV_MAJOR_VERSION in the workflow to '${BV_MAJOR}'"
            exit 1
          fi
          
          echo "✅ Version check passed: BV ${BV_VERSION} matches gate ${GATE_MAJOR}.x.x"

      - name: Update feagi-bv version
        run: |
          BV_VERSION="${{ steps.bv.outputs.version }}"
          echo "📝 Updating feagi-bv version to ${BV_VERSION}"
          
          # Update version in pyproject.toml
          sed -i.bak "s/^version = .*/version = \"${BV_VERSION}\"/" feagi-python-sdk/feagi-bv/pyproject.toml
          
          echo "Updated pyproject.toml:"
          grep "^version = " feagi-python-sdk/feagi-bv/pyproject.toml

      - name: Download Linux artifact
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mkdir -p bv-artifacts
          gh release download "${{ steps.bv.outputs.tag }}" \
            --repo feagi/brain-visualizer \
            --pattern "BrainVisualizer-Remote-Linux.tar.gz" \
            --dir bv-artifacts

      - name: Prepare Linux binaries
        run: |
          rm -rf feagi-python-sdk/feagi-bv/feagi_bv/bin
          mkdir -p feagi-python-sdk/feagi-bv/feagi_bv/bin/linux
          tar -xzf bv-artifacts/BrainVisualizer-Remote-Linux.tar.gz -C bv-artifacts
          if [ ! -f "bv-artifacts/BrainVisualizer-Remote.x86_64" ]; then
            echo "Missing BrainVisualizer-Remote.x86_64 in Linux artifact"
            exit 1
          fi
          mv bv-artifacts/BrainVisualizer-Remote.x86_64 feagi-python-sdk/feagi-bv/feagi_bv/bin/linux/BrainVisualizer
          chmod +x feagi-python-sdk/feagi-bv/feagi_bv/bin/linux/BrainVisualizer

      - name: Install build dependencies
        run: |
          python -m pip install --upgrade pip
          pip install build

      - name: Build Linux wheel
        working-directory: feagi-python-sdk/feagi-bv
        run: python -m build --wheel

      - name: Upload Linux wheel
        uses: actions/upload-artifact@v4
        with:
          name: feagi-bv-linux
          path: feagi-python-sdk/feagi-bv/dist/*.whl

  build-macos:
    name: Build feagi-bv wheel (macOS)
    runs-on: macos-13
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Resolve Brain Visualizer release
        id: bv
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Use input version if provided, otherwise use latest
          BV_INPUT="${{ inputs.bv_version }}"
          if [ -z "$BV_INPUT" ] || [ "$BV_INPUT" = "latest" ]; then
            BV_TAG=$(gh release view --repo feagi/brain-visualizer --json tagName -q .tagName)
          else
            BV_TAG="$BV_INPUT"
          fi
          echo "tag=${BV_TAG}" >> $GITHUB_OUTPUT
          
          # Extract version number
          BV_VERSION="${BV_TAG#v}"
          echo "version=${BV_VERSION}" >> $GITHUB_OUTPUT
          
          # Extract major version
          BV_MAJOR=$(echo "$BV_VERSION" | cut -d. -f1)
          
          # Get the gating major version
          GATE_MAJOR="${{ inputs.major_version }}"
          if [ -z "$GATE_MAJOR" ]; then
            GATE_MAJOR="${{ env.BV_MAJOR_VERSION }}"
          fi
          
          echo "🔍 Brain Visualizer release: ${BV_TAG} (version: ${BV_VERSION})"
          
          # Validate major version matches gate
          if [ "$BV_MAJOR" != "$GATE_MAJOR" ]; then
            echo "❌ ERROR: BrainVisualizer major version ${BV_MAJOR} does not match gate ${GATE_MAJOR}"
            exit 1
          fi

      - name: Update feagi-bv version
        run: |
          BV_VERSION="${{ steps.bv.outputs.version }}"
          sed -i.bak "s/^version = .*/version = \"${BV_VERSION}\"/" feagi-python-sdk/feagi-bv/pyproject.toml
          grep "^version = " feagi-python-sdk/feagi-bv/pyproject.toml

      - name: Download macOS artifact
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mkdir -p bv-artifacts
          gh release download "${{ steps.bv.outputs.tag }}" \
            --repo feagi/brain-visualizer \
            --pattern "BrainVisualizer-Remote-macOS.zip" \
            --dir bv-artifacts

      - name: Prepare macOS binaries
        run: |
          rm -rf feagi-python-sdk/feagi-bv/feagi_bv/bin
          mkdir -p feagi-python-sdk/feagi-bv/feagi_bv/bin/macos
          unzip -q bv-artifacts/BrainVisualizer-Remote-macOS.zip -d bv-artifacts
          if [ ! -d "bv-artifacts/BrainVisualizer-Remote.app" ]; then
            echo "Missing BrainVisualizer-Remote.app in macOS artifact"
            exit 1
          fi
          mv bv-artifacts/BrainVisualizer-Remote.app feagi-python-sdk/feagi-bv/feagi_bv/bin/macos/BrainVisualizer.app

      - name: Install build dependencies
        run: |
          python -m pip install --upgrade pip
          pip install build

      - name: Build macOS wheel
        working-directory: feagi-python-sdk/feagi-bv
        run: python -m build --wheel

      - name: Upload macOS wheel
        uses: actions/upload-artifact@v4
        with:
          name: feagi-bv-macos
          path: feagi-python-sdk/feagi-bv/dist/*.whl

  build-windows:
    name: Build feagi-bv wheel (Windows)
    runs-on: windows-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Resolve Brain Visualizer release
        id: bv
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: pwsh
        run: |
          # Use input version if provided, otherwise use latest
          $bvInput = "${{ inputs.bv_version }}"
          if ([string]::IsNullOrEmpty($bvInput) -or $bvInput -eq "latest") {
            $tag = gh release view --repo feagi/brain-visualizer --json tagName -q .tagName
          } else {
            $tag = $bvInput
          }
          "tag=$tag" | Out-File -FilePath $env:GITHUB_OUTPUT -Append
          
          # Extract version number (remove 'v' prefix if present)
          $version = $tag -replace '^v', ''
          "version=$version" | Out-File -FilePath $env:GITHUB_OUTPUT -Append
          
          # Extract major version
          $major = $version.Split('.')[0]
          
          # Get the gating major version
          $gateMajor = "${{ inputs.major_version }}"
          if ([string]::IsNullOrEmpty($gateMajor)) {
            $gateMajor = "${{ env.BV_MAJOR_VERSION }}"
          }
          
          Write-Host "🔍 Brain Visualizer release: $tag (version: $version)"
          
          # Validate major version matches gate
          if ($major -ne $gateMajor) {
            Write-Host "❌ ERROR: BrainVisualizer major version $major does not match gate $gateMajor"
            exit 1
          }

      - name: Update feagi-bv version
        shell: pwsh
        run: |
          $version = "${{ steps.bv.outputs.version }}"
          Write-Host "📝 Updating feagi-bv version to $version"
          
          $content = Get-Content feagi-python-sdk/feagi-bv/pyproject.toml
          $content = $content -replace '^version = .*', "version = `"$version`""
          $content | Set-Content feagi-python-sdk/feagi-bv/pyproject.toml
          
          Write-Host "Updated pyproject.toml:"
          Select-String -Path feagi-python-sdk/feagi-bv/pyproject.toml -Pattern '^version = '

      - name: Download Windows artifact
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Path bv-artifacts -Force | Out-Null
          gh release download "${{ steps.bv.outputs.tag }}" `
            --repo feagi/brain-visualizer `
            --pattern "BrainVisualizer-Remote-Windows.zip" `
            --dir bv-artifacts

      - name: Prepare Windows binaries
        shell: pwsh
        run: |
          Remove-Item -Recurse -Force feagi-python-sdk/feagi-bv/feagi_bv/bin -ErrorAction SilentlyContinue
          New-Item -ItemType Directory -Path feagi-python-sdk/feagi-bv/feagi_bv/bin/windows -Force | Out-Null
          Expand-Archive -Path bv-artifacts/BrainVisualizer-Remote-Windows.zip -DestinationPath bv-artifacts -Force
          if (-not (Test-Path "bv-artifacts/BrainVisualizer-Remote.exe")) {
            Write-Host "Missing BrainVisualizer-Remote.exe in Windows artifact"
            exit 1
          }
          if (-not (Test-Path "bv-artifacts/BrainVisualizer-Remote.pck")) {
            Write-Host "Missing BrainVisualizer-Remote.pck in Windows artifact"
            exit 1
          }
          Copy-Item "bv-artifacts/BrainVisualizer-Remote.exe" "feagi-python-sdk/feagi-bv/feagi_bv/bin/windows/BrainVisualizer.exe"
          Copy-Item "bv-artifacts/BrainVisualizer-Remote.pck" "feagi-python-sdk/feagi-bv/feagi_bv/bin/windows/BrainVisualizer.pck"
          Get-ChildItem -Path bv-artifacts -Filter "*.dll" | ForEach-Object {
            Copy-Item $_.FullName "feagi-python-sdk/feagi-bv/feagi_bv/bin/windows/$($_.Name)"
          }

      - name: Install build dependencies
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          pip install build

      - name: Build Windows wheel
        working-directory: feagi-python-sdk/feagi-bv
        shell: pwsh
        run: python -m build --wheel

      - name: Upload Windows wheel
        uses: actions/upload-artifact@v4
        with:
          name: feagi-bv-windows
          path: feagi-python-sdk/feagi-bv/dist/*.whl

  publish:
    name: Publish feagi-bv wheels
    needs: [build-linux, build-macos, build-windows]
    runs-on: ubuntu-latest
    permissions:
      id-token: write
    steps:
      - name: Determine target repository
        id: repo
        run: |
          if [[ "${{ github.ref }}" == "refs/heads/staging" ]]; then
            echo "target=testpypi" >> "$GITHUB_OUTPUT"
            echo "url=https://test.pypi.org/project/feagi-bv/" >> "$GITHUB_OUTPUT"
          elif [[ "${{ github.ref }}" == "refs/heads/main" ]]; then
            echo "target=pypi" >> "$GITHUB_OUTPUT"
            echo "url=https://pypi.org/project/feagi-bv/" >> "$GITHUB_OUTPUT"
          else
            echo "target=testpypi" >> "$GITHUB_OUTPUT"
            echo "url=https://test.pypi.org/project/feagi-bv/" >> "$GITHUB_OUTPUT"
          fi

      - name: Download all wheel artifacts
        uses: actions/download-artifact@v4
        with:
          path: dist-artifacts

      - name: Consolidate wheels
        run: |
          mkdir -p dist
          cp dist-artifacts/feagi-bv-linux/*.whl dist/
          cp dist-artifacts/feagi-bv-macos/*.whl dist/
          cp dist-artifacts/feagi-bv-windows/*.whl dist/
          ls -lh dist/

      - name: Publish to TestPyPI (staging)
        if: steps.repo.outputs.target == 'testpypi'
        uses: pypa/gh-action-pypi-publish@release/v1
        with:
          repository-url: https://test.pypi.org/legacy/
          skip-existing: true
          verbose: true

      - name: Publish to PyPI (production)
        if: steps.repo.outputs.target == 'pypi'
        uses: pypa/gh-action-pypi-publish@release/v1
        with:
          skip-existing: true
          verbose: true
