# ======= CREATE REST APP =======

def create_mock_app():
    """Create a minimal FastAPI app for testing."""
    # Create a minimal FastAPI app
    app = FastAPI()
    
    # Add dependency injector for core API and connectome
    core_api = MockCoreAPIService()
    connectome = MockConnectomeManager()
    
    # Create dependency functions
    def get_core_api():
        return core_api
        
    def get_connectome():
        return connectome
        
    # Store mappings in memory for testing
    CORTICAL_MAPPINGS = {
        "1": {
            "id": "1",
            "source_id": "101",
            "target_id": "102",
            "mapping_type": "one-to-one",
            "parameters": {}
        },
        "2": {
            "id": "2",
            "source_id": "102",
            "target_id": "101",
            "mapping_type": "probabilistic",
            "parameters": {"weight_multiplier": 0.5}
        }
    }
    
    # Add test routes for each group
    
    # Genome API routes
    @app.post("/v1/genome/upload/barebones")
    def upload_barebones(_core_api=Depends(get_core_api)):
        return {"message": "Barebones genome loaded successfully"}
        
    @app.post("/v1/genome/upload/essential")
    def upload_essential(_core_api=Depends(get_core_api)):
        return {"message": "Essential genome loaded successfully"}
        
    @app.get("/v1/genome/download")
    def download_genome(_core_api=Depends(get_core_api)):
        return _core_api.get_genome()
        
    @app.get("/v1/genome/download/region/{region_id}")
    def download_genome_region(region_id: str, _core_api=Depends(get_core_api)):
        return _core_api.get_genome()
        
    @app.get("/v1/genome/default_files")
    def genome_default_files(_core_api=Depends(get_core_api)):
        return {"files": ["barebones_genome.json", "essential_genome.json"]}
        
    @app.get("/v1/genome/number")
    def get_genome_number(_core_api=Depends(get_core_api)):
        return {"genome_number": 1}
        
    @app.post("/v1/genome/reset")
    def reset_genome(_core_api=Depends(get_core_api)):
        return {"message": "Genome reset successfully"}
        
    @app.post("/v1/genome/amalgamation")
    def amalgamation(_core_api=Depends(get_core_api)):
        return {"amalgamation_id": "202304050123_A", "message": "Amalgamation initiated"}
        
    @app.get("/v1/genome/amalgamation/history")
    def amalgamation_history(_core_api=Depends(get_core_api)):
        return {"amalgamations": _core_api.get_amalgamation_history()}
        
    @app.get("/v1/genome/cortical_template")
    def cortical_template(_core_api=Depends(get_core_api)):
        return _core_api.get_cortical_templates()
        
    @app.get("/v1/genome/circuits")
    def circuits(_core_api=Depends(get_core_api)):
        return _core_api.get_circuit_library()
        
    # Add string and file upload routes for genome
    @app.post("/v1/genome/upload/file")
    async def upload_genome_file(file: UploadFile = None):
        if not file:
            raise HTTPException(status_code=400, detail="No file provided")
            
        content = await file.read()
            
        try:
            json.loads(content.decode("utf-8"))
            return {"message": "Genome loaded successfully from file"}
        except (json.JSONDecodeError, UnicodeDecodeError):
            raise HTTPException(status_code=400, detail="Invalid JSON format")
            
    @app.post("/v1/genome/upload/string")
    async def upload_genome_string(data: dict):
        try:
            json.loads(data.get("genome", "{}"))
            return {"message": "Genome loaded successfully from string"}
        except json.JSONDecodeError:
            raise HTTPException(status_code=400, detail="Invalid JSON format")
    
    # Brain State API routes
    @app.get("/v1/brain/state")
    def brain_state(_core_api=Depends(get_core_api)):
        return _core_api.get_brain_state()
        
    @app.post("/v1/brain/stimulate")
    def stimulate_neurons(data: dict, _core_api=Depends(get_core_api)):
        return _core_api.stimulate_neurons(**data)
        
    @app.post("/v1/brain/areas")
    def create_area(data: dict, response: Response, _core_api=Depends(get_core_api)):
        result = _core_api.create_cortical_area(
            data["name"], data["type"], data["dimensions"], data["position"]
        )
        response.status_code = status.HTTP_201_CREATED
        return result
        
    @app.get("/v1/brain/activity")
    def brain_activity(_core_api=Depends(get_core_api)):
        return _core_api.get_activity()
        
    @app.get("/v1/brain/areas/{area_id}/activity")
    def area_activity(area_id: str, _core_api=Depends(get_core_api)):
        return _core_api.connectome.get_area_activity(area_id)
    
    # Mapping API routes
    @app.get("/v1/cortical_mapping/")
    def get_mappings(
        source_id: str = Query(None), 
        target_id: str = Query(None),
        _core_api=Depends(get_core_api)
    ):
        # Filter mappings based on query parameters
        filtered_mappings = list(CORTICAL_MAPPINGS.values())
        
        if source_id:
            filtered_mappings = [m for m in filtered_mappings if m["source_id"] == source_id]
            
        if target_id:
            filtered_mappings = [m for m in filtered_mappings if m["target_id"] == target_id]
            
        return {"mappings": filtered_mappings}
        
    @app.get("/v1/cortical_mapping/{mapping_id}")
    def get_mapping(mapping_id: str, _core_api=Depends(get_core_api)):
        if mapping_id not in CORTICAL_MAPPINGS:
            raise HTTPException(status_code=404, detail="Mapping not found")
            
        return CORTICAL_MAPPINGS[mapping_id]
        
    @app.post("/v1/cortical_mapping/")
    def create_mapping(data: dict, _core_api=Depends(get_core_api)):
        # Validate source and target IDs
        if data.get("source_id") == "999" or data.get("target_id") == "888":
            raise HTTPException(status_code=400, detail="Invalid source or target cortical area")
            
        # Create a new mapping
        new_id = str(len(CORTICAL_MAPPINGS) + 1)
        CORTICAL_MAPPINGS[new_id] = {
            "id": new_id,
            **data
        }
        return CORTICAL_MAPPINGS[new_id]
        
    @app.put("/v1/cortical_mapping/{mapping_id}")
    def update_mapping(mapping_id: str, data: dict, _core_api=Depends(get_core_api)):
        if mapping_id not in CORTICAL_MAPPINGS:
            raise HTTPException(status_code=404, detail="Mapping not found")
            
        # Update mapping
        CORTICAL_MAPPINGS[mapping_id].update(data)
        return CORTICAL_MAPPINGS[mapping_id]
        
    @app.delete("/v1/cortical_mapping/{mapping_id}")
    def delete_mapping(mapping_id: str, _core_api=Depends(get_core_api)):
        if mapping_id not in CORTICAL_MAPPINGS:
            raise HTTPException(status_code=404, detail="Mapping not found")
            
        del CORTICAL_MAPPINGS[mapping_id]
        return {"message": f"Mapping {mapping_id} deleted successfully"}
        
    @app.get("/v1/cortical_mapping/{mapping_id}/stats")
    def mapping_stats(mapping_id: str, _core_api=Depends(get_core_api)):
        if mapping_id not in CORTICAL_MAPPINGS:
            raise HTTPException(status_code=404, detail="Mapping not found")
            
        return {
            "source_id": CORTICAL_MAPPINGS[mapping_id]["source_id"],
            "target_id": CORTICAL_MAPPINGS[mapping_id]["target_id"],
            "synapse_count": 1000,
            "average_weight": 0.7,
            "connectivity_ratio": 0.8,
            "mapping_type": CORTICAL_MAPPINGS[mapping_id]["mapping_type"]
        }
        
    @app.post("/v1/cortical_mapping/apply")
    def apply_mapping(data: dict, _core_api=Depends(get_core_api)):
        return {
            "message": "Mapping applied successfully",
            "source_id": data.get("source_id", "101"),
            "target_id": data.get("target_id", "102"),
            "mapping_type": data.get("mapping_type", "one-to-one"),
            "connections_created": 1000
        }
        
    @app.get("/v1/cortical_mapping/templates")
    def mapping_templates(_core_api=Depends(get_core_api)):
        return _core_api.get_mapping_templates()
        
    # Add Burst Engine API routes
    @app.get("/v1/burst_engine/config")
    def get_burst_engine_config(_core_api=Depends(get_core_api)):
        return _core_api.get_burst_engine_config()
        
    @app.put("/v1/burst_engine/config")
    def update_burst_engine_config(data: dict, _core_api=Depends(get_core_api)):
        result = _core_api.update_burst_engine_config(data.get("parameters", {}))
        if result is False:
            raise HTTPException(status_code=400, detail="Failed to update burst engine configuration")
        return result
        
    @app.get("/v1/burst_engine/stats")
    def get_burst_engine_stats(_core_api=Depends(get_core_api)):
        return _core_api.get_burst_engine_stats()
        
    @app.post("/v1/burst_engine/start")
    def start_burst_engine(_core_api=Depends(get_core_api)):
        return {"status": "started"}
        
    @app.post("/v1/burst_engine/stop")
    def stop_burst_engine(_core_api=Depends(get_core_api)):
        return {"status": "stopped"}
        
    # Add other routes as needed
    
    return app

# ======= CLIENT FACTORY SYSTEM =======

# Store client instances by group to avoid recreating them
_client_cache: Dict[str, TestClient] = {}

@pytest.fixture(scope="session")
def client_factory():
    """Factory fixture to create TestClients with different configurations."""
    def _create_client(group_name: str = "default"):
        """Create a TestClient with custom configuration."""
        # Check cache first
        if group_name in _client_cache:
            return _client_cache[group_name]
        
        # Create the app
        app = create_mock_app()
        
        # Create and cache the client
        client = TestClient(app)
        _client_cache[group_name] = client
        return client
    
    return _create_client

@pytest.fixture
def client(client_factory):
    """Default client using standard configuration."""
    return client_factory("default")

