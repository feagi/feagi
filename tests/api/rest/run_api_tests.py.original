#!/usr/bin/env python
"""Script to run all FEAGI REST API tests with optimized performance."""

import os
import sys
import subprocess
import tempfile
import argparse
from pathlib import Path

def apply_import_patch():
    """Create a temporary patch file to mock imports."""
    patch_content = """
# Mock patch for heavy imports in FEAGI
import sys
from unittest.mock import MagicMock

# Create mocks for heavy modules
MOCKED_MODULES = [
    'torch', 
    'torch._tensor', 
    'torch.nn', 
    'torch.optim',
    'torch.utils',
    'torch.utils.data',
    'numpy',
    'numpy.random',
    'scipy',
    'scipy.sparse',
    'feagi.bdu.models.neuron',
    'feagi.bdu.models.cortical_area',
    'feagi.bdu.connectome_manager',
    'feagi.bdu.embryogenesis.neuroembryogenesis',
    'feagi.api.core.services.core_api_service',
    'feagi.api.core.services'
]

# Apply the mocks
for mod_name in MOCKED_MODULES:
    sys.modules[mod_name] = MagicMock()

# Make classes available
sys.modules['feagi.bdu.models.neuron'].Neuron = type('Neuron', (), {})
sys.modules['feagi.bdu.models.neuron'].NeuronArray = type('NeuronArray', (), {})
sys.modules['feagi.bdu.models.cortical_area'].CorticalArea = type('CorticalArea', (), {})
sys.modules['feagi.bdu.connectome_manager'].ConnectomeManager = type('ConnectomeManager', (), {})
sys.modules['feagi.api.core.services.core_api_service'].CoreAPIService = type('CoreAPIService', (), {})

# Add specific behavior to numpy
np_mock = sys.modules['numpy']
np_mock.array = lambda x: x
np_mock.zeros = lambda *args, **kwargs: [0] * (args[0] if args else 0)
np_mock.ones = lambda *args, **kwargs: [1] * (args[0] if args else 0)
"""
    
    patch_file = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.py')
    patch_file.write(patch_content)
    patch_file.close()
    
    return patch_file.name

def run_tests(pattern=None, group=None, verbose=False, parallel=1, patch_imports=False):
    """
    Run the API tests with the specified pattern or group.
    
    Args:
        pattern: Optional pattern to filter test files (e.g., 'region' for test_region_api.py)
        group: Optional API group to filter tests (e.g., 'brain_state', 'genome', etc.)
        verbose: Whether to run tests in verbose mode
        parallel: Number of parallel processes to use for testing
        patch_imports: Whether to patch imports to avoid loading heavy dependencies
    
    Returns:
        Exit code from pytest.
    """
    # Get the directory of this script
    script_dir = Path(os.path.dirname(os.path.abspath(__file__)))
    
    # Apply import patching if requested
    patch_file = None
    if patch_imports:
        patch_file = apply_import_patch()
        os.environ['PYTEST_PLUGINS'] = patch_file
    
    try:
        # Build the command
        cmd = ["pytest"]
        
        # Add verbosity
        if verbose:
            cmd.append("-v")
        
        # Add parallelism if requested
        if parallel > 1:
            cmd.append(f"-n={parallel}")
        
        # Add coverage if requested
        cmd.extend(["--cov=feagi.api.rest", "--cov-report=term"])
        
        # Add filter by group if specified
        if group:
            cmd.append(f"-m=api_group({group!r})")
        
        # Add pattern if specified, otherwise run all test_* files
        if pattern:
            cmd.append(f"test_{pattern}_api.py")
        else:
            cmd.append("test_*_api.py")
        
        # Suppress import errors if patching imports
        if patch_imports:
            cmd.append("--tb=native")
        
        # Print the command
        print(f"Running: {' '.join(cmd)}")
        print(f"Directory: {script_dir}")
        print("=" * 80)
        
        # Add import patching if requested
        env = None
        if patch_imports:
            env = os.environ.copy()
            env['PYTHONPATH'] = str(script_dir)
        
        # Run the command
        return subprocess.call(cmd, cwd=script_dir, env=env)
    finally:
        # Clean up patch file if created
        if patch_file and os.path.exists(patch_file):
            os.unlink(patch_file)

def main():
    """Run the tests with command line arguments."""
    parser = argparse.ArgumentParser(description="Run FEAGI REST API tests with optimized performance.")
    parser.add_argument("-p", "--pattern", help="Test pattern to run (e.g., 'region' to run test_region_api.py)")
    parser.add_argument("-g", "--group", help="API group to filter tests (e.g., 'brain_state', 'genome')")
    parser.add_argument("-v", "--verbose", action="store_true", help="Run tests in verbose mode")
    parser.add_argument("-j", "--parallel", type=int, default=1, 
                       help="Number of parallel processes to use (requires pytest-xdist)")
    parser.add_argument("--patch-imports", action="store_true", 
                       help="Patch imports to avoid loading heavy dependencies like PyTorch")
    parser.add_argument("--list-groups", action="store_true", 
                       help="List available API test groups and exit")
    args = parser.parse_args()
    
    if args.list_groups:
        print("Available API test groups:")
        print("  burst_engine - Tests for the Burst Engine API")
        print("  brain_state - Tests for the Brain State API")
        print("  genome - Tests for the Genome API")
        print("  mapping - Tests for the Cortical Mapping API")
        print("  region - Tests for the Brain Region API")
        print("  default - Tests not belonging to a specific group")
        sys.exit(0)
    
    try:
        exit_code = run_tests(args.pattern, args.group, args.verbose, args.parallel, args.patch_imports)
        sys.exit(exit_code)
    except KeyboardInterrupt:
        print("\nTest run canceled by user.")
        sys.exit(130)  # 130 is the standard exit code for SIGINT

if __name__ == "__main__":
    main() 