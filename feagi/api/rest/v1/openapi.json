        "type": "object",
        "properties": {
          "areas": {
            "title": "Areas",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CorticalAreaResponse"
            }
          }
        }
      },
      "CorticalAreaResponse": {
        "title": "CorticalAreaResponse",
        "required": [
          "name",
          "coordinates",
          "dimensions",
          "type",
          "id"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "coordinates": {
            "title": "Coordinates",
            "description": "3D coordinates of the cortical area",
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "dimensions": {
            "title": "Dimensions",
            "description": "Dimensions of the cortical area",
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "parameters": {
            "title": "Parameters",
            "description": "Additional parameters for the cortical area",
            "type": "object",
            "default": {}
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "neuron_count": {
            "title": "Neuron Count",
            "type": "integer",
            "default": 0
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/CorticalAreaBase"
          }
        ]
      },
      "HTTPValidationError": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "ValidationError": {
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object",
        "properties": {
          "loc": {
            "title": "Location",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
