            "type": "object",
            "default": {}
          }
        }
      },
      "CorticalAreaCreate": {
        "title": "CorticalAreaCreate",
        "allOf": [
          {
            "$ref": "#/components/schemas/CorticalAreaBase"
          }
        ]
      },
      "CorticalAreaList": {
        "title": "CorticalAreaList",
        "required": [
          "areas"
